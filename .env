# WARDEN Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (Defaulting to SQLite for zero-setup demo, easily switched to Postgres)
DATABASE_URL=sqlite:///./warden.db

# JWT Secrets
JWT_SECRET=warden_super_secret_demo_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OPA Configuration
OPA_URL=http://localhost:8181/v1/data/warden
OPA_FALLBACK_ENABLED=true

# Approvals & Escalation SLA (in seconds, default 120s for demo)
DEFAULT_APPROVAL_SLA_SECONDS=120
ESCALATION_CHECK_INTERVAL_SECONDS=5
